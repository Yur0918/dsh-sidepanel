{
  "name": "dsh-sidepanel",
  "version": "1.3.6",
  "description": "DSH right side panel: session artifacts view + side chat bound to the current session (auto-loads with the web profile)",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "scripts/install.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "package.json"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js",
    "test": "node --test test/client.test.mjs test/host.test.mjs test/safety.test.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "web-plugin",
    "side-panel",
    "artifacts",
    "side-chat"
  ]
}
